SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://rey-cms.vercel.app

# GSuite / Google Workspace SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@reycorp.com.au
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL=noreply@reycorp.com.au

# Used for open/click tracking pixels in emails (no trailing slash)
PUBLIC_BASE_URL=http://127.0.0.1:8000

